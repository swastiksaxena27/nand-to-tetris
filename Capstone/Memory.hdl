// Memory.hdl - address map of the Hack computer
//   0..16383   : RAM16K   (address[14]=0)
//   16384..24575: Screen  (address[13..14] = 10)
//   24576      : Keyboard (address[13..14] = 11)
CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    // Decide which device receives the "load" signal
    DMux4Way(in=load, sel=address[13..14], a=l0, b=l1, c=loadScreen, d=loadKbd);
    Or(a=l0, b=l1, out=loadRam);

    RAM16K(in=in, load=loadRam, address=address[0..13], out=ramOut);
    Screen(in=in, load=loadScreen, address=address[0..12], out=screenOut);
    Keyboard(out=kbdOut);

    // Decide which device's output goes out
    Mux4Way16(a=ramOut, b=ramOut, c=screenOut, d=kbdOut, sel=address[13..14], out=out);
}
